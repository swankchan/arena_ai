# LLM Configuration
LLM_PROVIDER=ollama # Options: ollama, openai
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=your_openai_api_key_here

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5 # 1024-dimension model
PERSIST_DIRECTORY=./chroma_db

# Search Settings
HYBRID_SEARCH=true # Enable keyword + vector search
VECTOR_WEIGHT=0.5 # Weight for vector search (0.0 to 1.0)
BM25_WEIGHT=0.5 # Weight for keyword search (0.0 to 1.0)
RERANKING=true # Enable reranking of retrieved documents
RERANK_MODEL=ms-marco-MiniLM-L-12-v2 # FlashRank model
TOP_K=4

# Query Optimization
QUERY_TRANSFORMATION=true # Use LLM to clarify query
QUERY_EXPANSION=true # Generate multiple variations of the query
ENABLE_RAGAS=false # Set to true to enable RAGAS evaluation by default

# Conversation memory & SQLite persistence (Q&A + ratings)
# APP_DB_PATH=./rag_app.db
LONG_TERM_MEMORY_TOP_K=3
CHAT_HISTORY_MAX_MESSAGES=12
CHAT_HISTORY_MAX_CHARS_PER_MESSAGE=2000

# Elasticsearch Configuration (for vector storage)
ES_URL=http://localhost:9200
ES_USER=elastic
ES_PASS=openrag
