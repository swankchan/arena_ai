# llama.cpp OpenAI-compatible server
LLAMA_CPP_BASE_URL=http://localhost:8080/v1
LLAMA_CPP_MODEL=local-model
# Placeholder is sufficient when llama.cpp authentication is disabled
LLAMA_CPP_API_KEY=not-needed

# Document processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
CHUNKING_STRATEGY=recursive
EMBEDDING_MODEL=google/embeddinggemma-2
# Native 768 dimensions; supported MRL alternatives: 512, 256, 128
EMBEDDING_DIMS=768
EMBEDDING_BATCH_SIZE=32
# Text-only mode loads 270M parameters instead of all 740M
EMBEDDING_TEXT_ONLY=true
# Optional: auto (unset), cpu, cuda, cuda:0, or mps
# EMBEDDING_DEVICE=cpu
DOCUMENTS_DIRECTORY=./documents

# Retrieval and reranking
RERANKING=true
RERANK_MODEL=ms-marco-MiniLM-L-12-v2
TOP_K=4

# Query optimization
QUERY_TRANSFORMATION=true
QUERY_EXPANSION=true

# Conversation memory and SQLite persistence
APP_DB_PATH=./rag_app.db
LONG_TERM_MEMORY_TOP_K=3
CHAT_HISTORY_MAX_MESSAGES=12
CHAT_HISTORY_MAX_CHARS_PER_MESSAGE=2000

# Embedded LanceDB vector store
LANCEDB_PATH=./lance_db

# FastAPI and React production build
FRONTEND_DIST=./frontend/dist
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=50
MAX_SQL_ROWS=1000
# In-process ingestion jobs; keep at 1 for local model workloads
INGESTION_WORKERS=1
