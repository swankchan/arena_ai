+test('主迴圈會更新地圖，並且把相機位置傳給行人 LOD', () => {
+  const main = readFileSync(new URL('../js/hk/main.js', import.meta.url), 'utf8');
+  assert.match(main, /map\.update\(player\.state, carPositions\)/, '地圖唔可以只喺開啟時畫一次初始狀態');
+  assert.match(main, /mapTime >= 0\.25/, '地圖重畫要節流，唔好每幀掃千幾棟樓');
+  assert.match(main, /pedestrians\.update\?\.\(dt, camera\.position\)/, '主迴圈要保留行人遠近 LOD');
+});
+
+test('數字鍵、HUD、地圖傳送共用即時車身與鏡頭重設', () => {
+  const main = readFileSync(new URL('../js/hk/main.js', import.meta.url), 'utf8');
+  const start = main.indexOf('  function teleportTo(');
+  const end = main.indexOf('  // --- 地圖', start);
+  assert.ok(start >= 0 && end > start, '搵到共用的 teleportTo');
+
+  const calls = [];
+  const player = {
+    state: { x: 1, z: 2, heading: 0.3, speed: 20 },
+    sync: () => calls.push(['sync'])
+  };
+  const chase = {
+    smoothed: { set: (...args) => calls.push(['smoothed', ...args]) },
+    lookAt: { set: (...args) => calls.push(['lookAt', ...args]) }
+  };
+  const context = { player, chase };
+  vm.runInNewContext(main.slice(start, end), context);
+
+  context.teleportTo(100, 200, 1.2);
+  assert.equal(player.state.x, 100);
+  assert.equal(player.state.z, 200);
+  assert.equal(player.state.heading, 1.2);
+  assert.equal(player.state.speed, 0);
+  assert.deepEqual(calls[0], ['sync'], '傳送後要即時同步車身，唔好等下一幀');
+  assert.ok(calls.some((call) => call[0] === 'smoothed'), '要重設追尾鏡頭位置錨點');
+  assert.ok(calls.some((call) => call[0] === 'lookAt'), '要重設鏡頭注視點');
+
+  context.teleportTo(300, 400);
+  assert.equal(player.state.heading, 1.2, '地圖點擊冇指定 heading 時要保留車頭方向');
+  assert.equal([...main.matchAll(/teleportTo\(tp\.x, tp\.z, tp\.heading\)/g)].length, 2,
+    '數字鍵與 HUD 都要行共用傳送路徑');
+  assert.doesNotMatch(main, /player\.state\.x = tp\.x/, '預設傳送唔應再繞過共用重設');
+});
